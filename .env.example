# No copies credenciales a archivos. Usa npm run sandbox con 1Password CLI.
PAYMENTS_MODE=mock
PORT=4317
# Selector no secreto del elemento de 1Password; campo CONCEALED credential.
REAP_VAULT_ITEM=StockRescue Reap sandbox
# La demo local abre la página de Reap en otra pestaña. Vuelve y consulta estado.
REAP_RETURN_URL=https://docs.reap.global/agentic-payments/setup
REAP_HOSTED_HOSTS=sandbox.collect.prava.space
# Opcional: ruta local de SQLite; no uses la misma base para mock y sandbox.
# STOCKRESCUE_DB=.data/stockrescue-sandbox.sqlite

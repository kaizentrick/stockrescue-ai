# Copia local opcional: .env.agent (ignorada por Git).
# También puedes inyectar estas variables desde un gestor de secretos.
# Llave emitida por Google AI Studio; nunca va al frontend ni a la URL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta Developers -> WhatsApp -> API Setup. ID del número, no WABA ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Secreto propio de al menos 16 caracteres para verificar el callback.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# Destinatarios autorizados/con consentimiento; formato internacional sin +.
WHATSAPP_ALLOWED_SENDERS=
# Debe existir y estar aprobada en la cuenta Meta antes de enviar alertas.
WHATSAPP_ALERT_TEMPLATE=stockrescue_low_stock
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

AGENT_PORT=4318
AGENT_DB=.data/stockrescue-agent.sqlite
# El agente complementa la misma tienda que npm start, compartiendo estado.
PAYMENTS_MODE=mock
# Opcional; sin esta variable se elige la base del modo actual automáticamente.
# STOCKRESCUE_DB=.data/stockrescue-mock.sqlite
# Opt-in: confirmar un preview puede enviar un checkout local/sandbox.
AGENT_ALLOW_CHECKOUT=false
# Para sandbox: usar npm run agent:sandbox con la bóveda existente.
# Si usas una ruta personalizada, selecciona la misma base sandbox que el SaaS.
